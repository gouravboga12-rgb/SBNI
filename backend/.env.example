# Environment Configuration
PORT=5000
NODE_ENV=development

DATABASE_URL="postgresql://username:password@localhost:5432/sbni_db?schema=public"

# Authentication & Security
JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS Allowed Origins
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,https://justpaisa.in"

# Payment Gateway Setup (Razorpay)
PAYMENT_GATEWAY_KEY="your_razorpay_key_id_here"
PAYMENT_GATEWAY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_KEY_ID="your_razorpay_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_app_password"
SMTP_FROM="JustPaisa <your_email@gmail.com>"

# Mapbox Location Services
MAPBOX_ACCESS_TOKEN="your_mapbox_access_token_here"

# AWS S3 Media Storage Vault
AWS_S3_BUCKET_NAME="your_s3_bucket_name"
AWS_S3_REGION="ap-south-2"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
